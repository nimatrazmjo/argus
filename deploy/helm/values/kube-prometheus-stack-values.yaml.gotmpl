# deploy/helm/values/kube-prometheus-stack-values.yaml
# Declarative configuration for Prometheus Operator using upstream images
# Minimal ATO footprint: deploys the Prometheus Operator controller and CRDs.

{{- $reg := env "ARGUS_IMAGE_REGISTRY" }}
prometheusOperator:
  enabled: true
  tls:
    enabled: false
  image:
    registry: {{ if $reg }}{{ $reg }}/argus{{ else }}quay.io{{ end }}
    repository: {{ if $reg }}"prometheus-operator"{{ else }}"prometheus-operator/prometheus-operator"{{ end }}
    tag: "v0.94.1"
  prometheusConfigReloader:
    image:
      registry: {{ if $reg }}{{ $reg }}/argus{{ else }}quay.io{{ end }}
      repository: {{ if $reg }}"prometheus-config-reloader"{{ else }}"prometheus-operator/prometheus-config-reloader"{{ end }}
      tag: "v0.94.1"
  admissionWebhooks:
    enabled: false

# Disable non-operator components for Phase 01 operator baseline (minimal ATO surface)
alertmanager:
  enabled: false
grafana:
  enabled: false
prometheus:
  enabled: false
nodeExporter:
  enabled: false
kubeStateMetrics:
  enabled: false
defaultRules:
  create: false
kubeApiServer:
  enabled: false
kubelet:
  enabled: false
kubeControllerManager:
  enabled: false
coreDns:
  enabled: false
kubeDns:
  enabled: false
kubeEtcd:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false
